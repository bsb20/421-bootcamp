{
  "name": "UNC COMP 421 Bootcamp",
  "image": "ubuntu:22.04",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "CC": "clang-14",
    "CXX": "clang++-14"
  },
  "runArgs": [
    "--security-opt", "seccomp=unconfined",
    "--cap-add", "SYS_PTRACE"
  ],
  // Wait for postCreateCommand (which configures CMake and generates
  // build/compile_commands.json) to finish before VS Code connects and starts
  // clangd. Otherwise clangd starts before the compile DB exists and can't find
  // it, requiring a manual "clangd: Restart language server".
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "debug.showVariableTypes": true,
        "cmake.configureOnOpen": true,
        "cmake.useCMakePresets": "always",
        "clangd.path": "clangd-14",
        "clangd.arguments": [
          "--background-index"
        ]
      }
    }
  },
  "postCreateCommand" : "echo y | ./packages.sh; git remote add public https://github.com/bsb20/421-bootcamp; cmake --preset debug"
}
